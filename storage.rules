rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // each student may upload only their own small profile photo; anyone can view it (it is shown in push notifications)
    match /avatars/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && file == request.auth.uid + '.jpg'
                   && request.resource.size < 200 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }
    // everything else keeps its current behaviour: signed-in users only
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
